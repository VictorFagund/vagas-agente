{
  "name": "Vagas novas no Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8
            }
          ]
        }
      },
      "name": "Todo dia às 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "name": "Rodar agora (teste)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "command": "={{ 'cd /d \"' + $env.VAGAS_AGENTE + '\" && .venv\\\\Scripts\\\\python.exe src\\\\agente.py --limite 15' }}"
      },
      "name": "Coletar e avaliar vagas",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        260,
        100
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "command": "={{ 'cd /d \"' + $env.VAGAS_AGENTE + '\" && .venv\\\\Scripts\\\\python.exe src\\\\novas.py --nota 70' }}"
      },
      "name": "Separar vagas novas 70+",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        520,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const saida = JSON.parse($input.first().json.stdout);\nif (!saida.total) return [];\nreturn [{ json: saida }];"
      },
      "name": "Tem vaga nova?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.mensagem, disable_web_page_preview: true }) }}",
        "options": {}
      },
      "name": "Mandar no Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        100
      ]
    },
    {
      "parameters": {
        "command": "={{ 'cd /d \"' + $env.VAGAS_AGENTE + '\" && .venv\\\\Scripts\\\\python.exe src\\\\novas.py --marcar ' + $('Tem vaga nova?').first().json.vagas.map(v => v.id).join(',') }}"
      },
      "name": "Marcar como avisadas",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1300,
        100
      ]
    }
  ],
  "connections": {
